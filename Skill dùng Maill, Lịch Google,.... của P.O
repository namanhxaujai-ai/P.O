const CAU_HINH = { MUI_GIO: 'Asia/Ho_Chi_Minh', TEN_SHEET: 'Email_Log', TOI_DA: 20, DO_DAI_GUI: 5000, DO_DAI_DOC: 500 };
const TIEU_DE = ['ID', 'Thời gian', 'Loại', 'Người gửi/nhận', 'Tiêu đề', 'Nội dung', 'Kết quả'];
const TIEN_TO_ID = { 'GỬI': 'GUI', 'ĐỌC': 'DOC', 'TRẢ LỜI': 'TRL', 'NHÁP': 'NHP', 'XÓA': 'XOA', 'TÌM KIẾM': 'TIM', 'LIỆT KÊ': 'LKE', 'GẮN NHÃN': 'NHN' };
const THIEU = 'Thiếu người nhận (to), tiêu đề (subject) hoặc nội dung (body)';
const THAM_SO_SO = ['maxResults', 'maxRows'];   

// Danh sách lệnh AI được dùng
const TUYEN = {
  'gmail.listEmails':   { ham: lietKeEmail,  moTa: 'Liệt kê thư trong Hộp thư đến',                thamSo: 'maxResults (mặc định 10, tối đa 20)' },
  'gmail.searchEmails': { ham: timKiemEmail, moTa: 'Tìm thư theo cú pháp tìm kiếm Gmail',          thamSo: 'query (bắt buộc), maxResults' },
  'gmail.readEmail':    { ham: docEmail,     moTa: 'Đọc một thư hoặc cả luồng thư',                thamSo: 'messageId hoặc threadId' },
  'gmail.sendEmail':    { ham: guiEmail,     moTa: 'Gửi thư mới',                                  thamSo: 'to, subject, body (bắt buộc); htmlBody, cc, bcc', ghi: true },
  'gmail.replyEmail':   { ham: traLoiEmail,  moTa: 'Trả lời trong một luồng thư',                  thamSo: 'threadId, body (bắt buộc); htmlBody', ghi: true },
  'gmail.createDraft':  { ham: taoThuNhap,   moTa: 'Tạo thư nháp (chưa gửi)',                      thamSo: 'to, subject, body (bắt buộc); htmlBody', ghi: true },
  'gmail.labelEmail':   { ham: ganNhanEmail, moTa: 'Gắn nhãn cho luồng thư',                       thamSo: 'threadId, labelName (bắt buộc); create (true/false)', ghi: true },
  'gmail.trashEmail':   { ham: xoaEmail,     moTa: 'Chuyển luồng thư vào Thùng rác',               thamSo: 'threadId (bắt buộc)', ghi: true },
  'gmail.listLabels':   { ham: lietKeNhan,   moTa: 'Danh sách nhãn Gmail',                         thamSo: 'không có' },
  'system.log':         { ham: layNhatKy,    moTa: 'Xem nhật ký thao tác gần nhất',                thamSo: 'maxRows (mặc định 50, tối đa 200)' },
  'system.listRoutes':  { ham: _huongDan,    moTa: 'Liệt kê toàn bộ lệnh kèm mô tả và tham số',    thamSo: 'không có' },
};

// -- Điểm vào (doPost / doGet là tên bắt buộc của Apps Script) --

// Cách 1 - POST body JSON: { "token": "...", "action": "gmail.sendEmail", "params": { ... } }
function doPost(e) {
  try {
    if (!e || !e.postData) throw new Error('Yêu cầu rỗng');
    const body = JSON.parse(e.postData.contents);
    _kiemTraToken(body.token);
    return _json({ ok: true, result: _tim(body.action).ham(body.params || {}) });
  } catch (loi) {
    return _json({ ok: false, error: loi.message });
  }
}

// Cách 2 - GET cho AI chỉ mở được URL:
function doGet(e) {
  try {
    const q = (e && e.parameter) || {};
    if (q.action) {
      _kiemTraToken(q.token);
      const lenh = _tim(q.action);
      if (lenh.ghi && q.confirm !== 'yes') throw new Error('Lệnh ghi qua GET cần thêm &confirm=yes');
      return _json({ ok: true, result: lenh.ham(_docThamSoGet(q)) });
    }
    const cmd = q.cmd || 'status';
    if (cmd === 'help') return _json({ ok: true, result: _huongDan() });
    if (cmd === 'status') return _json({ ok: true, service: 'Gmail AI Manager', version: '3.5', help: '?cmd=help' });
    throw new Error('Lệnh GET không hợp lệ');
  } catch (loi) {
    return _json({ ok: false, error: loi.message });
  }
}

// -- Tiện ích --
const _json = d => ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON);
const _ngay = (d = new Date()) => Utilities.formatDate(d, CAU_HINH.MUI_GIO, 'yyyy-MM-dd HH:mm:ss');
const _loc = o => Object.fromEntries(Object.entries(o).filter(([, v]) => v));

function _tim(action) {
  if (!TUYEN[action]) throw new Error('Không tìm thấy action: ' + action);
  return TUYEN[action];
}

// Đọc tham số từ GET.
function _docThamSoGet(q) {
  const rieng = ['action', 'confirm', 'token', 'params', 'p'];
  const thamSo = {};
  Object.keys(q).forEach(k => {
    if (rieng.includes(k)) return;
    const v = q[k];
    thamSo[k] = THAM_SO_SO.includes(k) ? Number(v) : v === 'true' ? true : v === 'false' ? false : v;
  });
  try {
    if (q.p) {
      const json = Utilities.newBlob(Utilities.base64DecodeWebSafe(q.p)).getDataAsString('UTF-8');
      Object.assign(thamSo, JSON.parse(json));
    } else if (q.params) {
      Object.assign(thamSo, JSON.parse(q.params));
    }
  } catch (loi) {
    throw new Error('Không đọc được JSON trong params/p: ' + loi.message);
  }
  return thamSo;
}

// Kiểm tra token bí mật 
function _kiemTraToken(t) {
  const dung = PropertiesService.getScriptProperties().getProperty('API_TOKEN');
  if (!dung || t !== dung) throw new Error('Unauthorized');
}

function _huongDan() {
  const chiTiet = {};
  Object.keys(TUYEN).forEach(k => { chiTiet[k] = { moTa: TUYEN[k].moTa, thamSo: TUYEN[k].thamSo, ghi: !!TUYEN[k].ghi }; });
  return {
    routes: Object.keys(TUYEN), chiTiet,
    cachGoi: {
      POST: '{"token":"...","action":"...","params":{...}}',
      GET: '?action=...&token=...&tham_so=...  (lệnh ghi thêm &confirm=yes; có thể dùng p=<base64url JSON> hoặc params=<JSON>)',
    },
  };
}

function _luong(ma) {
  const luong = GmailApp.getThreadById(ma);
  if (!luong) throw new Error('Không tìm thấy luồng thư (threadId)');
  return luong;
}

// -- Nhật ký (Google Sheet) --
function _trangNhatKy() {
  const tp = PropertiesService.getScriptProperties();
  let bang;
  const id = tp.getProperty('LOG_SPREADSHEET_ID');
  if (id) bang = SpreadsheetApp.openById(id); 
  else {
    bang = SpreadsheetApp.create('Lịch Sử Sử Dụng Mail Của P.O');
    tp.setProperty('LOG_SPREADSHEET_ID', bang.getId());
  }
  let trang = bang.getSheetByName(CAU_HINH.TEN_SHEET);
  if (!trang) {
    const dsTrang = bang.getSheets();
    if (dsTrang.length === 1 && dsTrang[0].getLastRow() === 0) { trang = dsTrang[0]; trang.setName(CAU_HINH.TEN_SHEET); }
    else trang = bang.insertSheet(CAU_HINH.TEN_SHEET);
    trang.appendRow(TIEU_DE);
    trang.setFrozenRows(1);
    trang.getRange(1, 1, 1, TIEU_DE.length).setFontWeight('bold');
  }
  return trang;
}

function _idTiepTheo(loai) {
  const tienTo = TIEN_TO_ID[loai] || 'LOG', tp = PropertiesService.getScriptProperties(), khoa = 'COUNTER_' + tienTo;
  const tiep = (parseInt(tp.getProperty(khoa), 10) || 0) + 1;
  tp.setProperty(khoa, String(tiep));
  return tienTo + String(tiep).padStart(4, '0');
}

// Chạy hamThucThi(), ghi nhật ký THÀNH CÔNG / THẤT BẠI rồi trả kết quả.
function _kemNhatKy(tt, doDai, hamThucThi) {
  let trangThai = 'THÀNH CÔNG';
  try { return hamThucThi(); }
  catch (loi) { trangThai = 'THẤT BẠI'; throw loi; }
  finally {
    const khoa = LockService.getScriptLock();
    try {
      khoa.waitLock(10000);
      _trangNhatKy().appendRow([_idTiepTheo(tt.loai), _ngay(), tt.loai, tt.doiTac || '', tt.tieuDe || '',
        String(tt.noiDung || '').substring(0, doDai), trangThai]);
    } catch (loi) {
      // Không làm hỏng thao tác chính, nhưng lưu lại lý do để biết vì sao không ghi được vào Sheet
      Logger.log('Không ghi được nhật ký: ' + loi.message);
      try { PropertiesService.getScriptProperties().setProperty('LOG_LOI_CUOI', _ngay() + ' - ' + loi.message); } catch (_) {}
    } finally { try { khoa.releaseLock(); } catch (_) {} }
  }
}

// -- Gmail --
function guiEmail({ to: nguoiNhan, subject: tieuDe, body: noiDung, htmlBody: noiDungHtml, cc, bcc }) {
  const tt = { loai: 'GỬI', tieuDe, noiDung, doiTac: [nguoiNhan, cc && 'cc: ' + cc, bcc && 'bcc: ' + bcc].filter(Boolean).join(' | ') };
  return _kemNhatKy(tt, CAU_HINH.DO_DAI_GUI, () => {
    if (!nguoiNhan || !tieuDe || !noiDung) throw new Error(THIEU);
    GmailApp.sendEmail(nguoiNhan, tieuDe, noiDung, _loc({ htmlBody: noiDungHtml, cc, bcc }));
    return { sent: true, to: nguoiNhan, subject: tieuDe };
  });
}

function traLoiEmail({ threadId: maLuong, body: noiDung, htmlBody: noiDungHtml }) {
  const tt = { loai: 'TRẢ LỜI', noiDung };
  return _kemNhatKy(tt, CAU_HINH.DO_DAI_GUI, () => {
    if (!maLuong || !noiDung) throw new Error('Thiếu threadId hoặc nội dung (body)');
    const luong = _luong(maLuong);
    tt.doiTac = luong.getMessages().slice(-1)[0].getFrom();
    tt.tieuDe = luong.getFirstMessageSubject();
    luong.reply(noiDung, _loc({ htmlBody: noiDungHtml }));
    return { replied: true, threadId: maLuong };
  });
}

function taoThuNhap({ to: nguoiNhan, subject: tieuDe, body: noiDung, htmlBody: noiDungHtml }) {
  const tt = { loai: 'NHÁP', doiTac: nguoiNhan, tieuDe, noiDung };
  return _kemNhatKy(tt, CAU_HINH.DO_DAI_GUI, () => {
    if (!nguoiNhan || !tieuDe || !noiDung) throw new Error(THIEU);
    const nhap = GmailApp.createDraft(nguoiNhan, tieuDe, noiDung, _loc({ htmlBody: noiDungHtml }));
    return { draftId: nhap.getId() };
  });
}

function docEmail({ threadId: maLuong, messageId: maThu }) {
  const tt = { loai: 'ĐỌC' };
  return _kemNhatKy(tt, CAU_HINH.DO_DAI_DOC, () => {
    if (maThu) {
      const thu = GmailApp.getMessageById(maThu);
      if (!thu) throw new Error('Không tìm thấy thư (messageId)');
      Object.assign(tt, { doiTac: thu.getFrom(), tieuDe: thu.getSubject(), noiDung: thu.getPlainBody() });
      return {
        from: thu.getFrom(), to: thu.getTo(), subject: thu.getSubject(), date: thu.getDate().toISOString(),
        body: thu.getPlainBody(), htmlBody: thu.getBody(), attachments: thu.getAttachments().map(t => t.getName()),
      };
    }
    if (!maLuong) throw new Error('Cần có threadId hoặc messageId');
    const luong = _luong(maLuong), dsThu = luong.getMessages();
    Object.assign(tt, { tieuDe: luong.getFirstMessageSubject(), doiTac: dsThu[0].getFrom(), noiDung: dsThu.slice(-1)[0].getPlainBody() });
    return dsThu.map(thu => ({
      id: thu.getId(), from: thu.getFrom(), to: thu.getTo(), subject: thu.getSubject(),
      date: thu.getDate().toISOString(), body: thu.getPlainBody().substring(0, 3000),
    }));
  });
}

function lietKeEmail({ maxResults = 10 }) {
  return _kemNhatKy({ loai: 'LIỆT KÊ', noiDung: 'maxResults=' + maxResults }, CAU_HINH.DO_DAI_DOC, () =>
    GmailApp.getInboxThreads(0, Math.min(maxResults, CAU_HINH.TOI_DA)).map(luong => {
      const dsThu = luong.getMessages();
      return {
        threadId: luong.getId(), subject: luong.getFirstMessageSubject(), from: dsThu[0].getFrom(),
        date: dsThu[0].getDate().toISOString(), snippet: dsThu.slice(-1)[0].getPlainBody().substring(0, 200),
        unread: luong.isUnread(),
      };
    }));
}

function timKiemEmail({ query: tuKhoa, maxResults = 10 }) {
  return _kemNhatKy({ loai: 'TÌM KIẾM', noiDung: tuKhoa }, CAU_HINH.DO_DAI_DOC, () => {
    if (!tuKhoa) throw new Error('Thiếu từ khóa tìm kiếm (query)');
    return GmailApp.search(tuKhoa, 0, Math.min(maxResults, CAU_HINH.TOI_DA)).map(luong => ({
      threadId: luong.getId(), subject: luong.getFirstMessageSubject(),
      messageCount: luong.getMessageCount(), lastDate: luong.getLastMessageDate().toISOString(),
    }));
  });
}

function ganNhanEmail({ threadId: maLuong, labelName: tenNhan, create: taoMoi = false }) {
  const tt = { loai: 'GẮN NHÃN', noiDung: tenNhan };
  return _kemNhatKy(tt, CAU_HINH.DO_DAI_DOC, () => {
    const nhan = GmailApp.getUserLabelByName(tenNhan) || (taoMoi && GmailApp.createLabel(tenNhan));
    if (!nhan) throw new Error('Không tìm thấy nhãn: ' + tenNhan);
    const luong = _luong(maLuong);
    tt.tieuDe = luong.getFirstMessageSubject();
    tt.doiTac = luong.getMessages()[0].getFrom();
    luong.addLabel(nhan);
    return { labeled: true };
  });
}

function xoaEmail({ threadId: maLuong }) {
  const tt = { loai: 'XÓA' };
  return _kemNhatKy(tt, CAU_HINH.DO_DAI_DOC, () => {
    const luong = _luong(maLuong);
    tt.tieuDe = luong.getFirstMessageSubject();
    tt.doiTac = luong.getMessages()[0].getFrom();
    luong.moveToTrash();
    return { trashed: true };
  });
}

function lietKeNhan() {
  return GmailApp.getUserLabels().map(nhan => ({ name: nhan.getName(), id: nhan.getId() }));
}

function layNhatKy({ maxRows = 50 }) {
  const trang = _trangNhatKy();
  return {
    logs: trang.getDataRange().getValues().slice(-Math.min(maxRows, 200)), url: trang.getParent().getUrl(),
    loiGhiNhatKy: PropertiesService.getScriptProperties().getProperty('LOG_LOI_CUOI') || null,
  };
}

// -- Thử nghiệm --
//Bắt buộc phải chạy
function thuNghiem_taoToken() {
  const tp = PropertiesService.getScriptProperties();
  if (tp.getProperty('API_TOKEN')) { Logger.log('API_TOKEN đã tồn tại. Xóa nó trong Script Properties nếu muốn tạo mới.'); return; }
  const token = (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '');
  tp.setProperty('API_TOKEN', token);
  Logger.log('API_TOKEN mới: ' + token);
}

function thuNghiem_ghiNhatKy() {
  _kemNhatKy({ loai: 'LIỆT KÊ', noiDung: 'thử ghi nhật ký' }, CAU_HINH.DO_DAI_DOC, () => true);
  const trang = _trangNhatKy(), bang = trang.getParent();
  Logger.log('Sheet nhật ký: ' + bang.getUrl());
  Logger.log('Các tab trong Sheet: ' + bang.getSheets().map(t => t.getName() + ' (' + t.getLastRow() + ' dòng)').join(', '));
  Logger.log('Dòng nhật ký cuối cùng: ' + JSON.stringify(trang.getRange(trang.getLastRow(), 1, 1, TIEU_DE.length).getValues()[0]));
  Logger.log('Lỗi ghi gần nhất: ' + (PropertiesService.getScriptProperties().getProperty('LOG_LOI_CUOI') || 'không có'));
}

function thuNghiem_taoLaiNhatKy() {
  PropertiesService.getScriptProperties().deleteProperty('LOG_SPREADSHEET_ID');
  thuNghiem_ghiNhatKy();
}

function thuNghiem_guiEmail() {
  Logger.log(JSON.stringify(guiEmail({ to: 'aloaedayaf123@gmail.com', subject: 'Thử Nghiệm 1', body: 'Thư thử nghiệm số 1' })));
}
